{
    // See https://microsoft.com
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build release",
            "type": "process",
            "command": "C:/raylib/w64devkit/bin/g++.exe",
            "args": [
                "-std=c++14",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/button.cpp",//Пример того как вписывать свои новые файлы для компиляции 
                "-o",
                "${workspaceFolder}/main.exe",
                "-IC:/raylib/raylib/src",
                "-LC:/raylib/raylib/src",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-O2",
                "-mwindows",
                "-static"
            ],
            "windows": {
                "command": "C:/raylib/w64devkit/bin/g++.exe",
                "args": [
                    "-std=c++14",
                    "${workspaceFolder}/src/main.cpp",
                    "${workspaceFolder}/src/button.cpp",
                    "-o",
                    "${workspaceFolder}/main.exe",
                    "-IC:/raylib/raylib/src",
                    "-LC:/raylib/raylib/src",
                    "-lraylib",
                    "-lopengl32",
                    "-lgdi32",
                    "-lwinmm",
                    "-O2",
                    "-mwindows",
                    "-static"
                ],
                "options": {
                    "env": {
                        "PATH": "C:\\raylib\\w64devkit\\bin;${env:PATH}"
                    }
                }
            },
            "osx": {
                "args": [
                    "PROJECT_NAME=${fileBasenameNoExtension}",
                    "OBJS=src/*.cpp"
                ]
            },
            "linux": {
                "args": [
                    "PROJECT_NAME=${fileBasenameNoExtension}",
                    "DESTDIR=/home/linuxbrew/.linuxbrew",
                    "RAYLIB_LIBTYPE=SHARED",
                    "EXAMPLE_RUNTIME_PATH=/home/linuxbrew/.linuxbrew/lib",
                    "OBJS=src/*.cpp"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "compiler: C:\\raylib\\w64devkit\\bin\\g++.exe"
        }
    ]
}
